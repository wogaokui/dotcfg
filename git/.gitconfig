[color]
	ui = auto
[alias]
	co = checkout
	cm = commit
	st = status
	br = branch
[pull]
	rebase = true
[core]
	editor = vim
[includeIf "gitdir:~/adc/**"]
	path = ~/.gitconfig_work
[includeIf "gitdir:~/robot/**"]
	path = ~/.gitconfig_work
[includeIf "gitdir:/sandbox/**"]
	path = ~/.gitconfig_work
[safe]
	directory = /sandbox/imos
	directory = /sandbox/imos
